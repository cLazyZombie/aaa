{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "default": "5m",
          "type": "string"
        },
        "max_minutes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_wakes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min_gap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "const": 0
            }
          ],
          "description": "생략 또는0이면 제한 없음"
        },
        "usage_session_below": {
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "usage_week_below": {
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Reset": {
      "additionalProperties": false,
      "not": {
        "required": [
          "every",
          "daily"
        ]
      },
      "properties": {
        "after_wakes": {
          "default": 6,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "daily": {
          "type": [
            "string",
            "null"
          ]
        },
        "every": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brief_file": {
      "type": "string"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "limits": {
      "$ref": "#/$defs/Limits",
      "default": {
        "batch": "5m"
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": "string"
    },
    "repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "reset": {
      "$ref": "#/$defs/Reset",
      "default": {
        "after_wakes": 6
      }
    },
    "retire_cap_days": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "retire_no_posts_days": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "withdrawal": {
      "default": "criteria",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "brief_file"
  ],
  "title": "AAA 임무",
  "type": "object"
}
