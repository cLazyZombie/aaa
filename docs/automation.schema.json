{
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "enum": [
            "deploy"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "inbox": {
              "$ref": "#/$defs/Inbox"
            }
          },
          "required": [
            "inbox"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "message": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/Start"
            }
          },
          "required": [
            "start"
          ],
          "type": "object"
        }
      ]
    },
    "CatchUp": {
      "enum": [
        "once",
        "skip"
      ],
      "type": "string"
    },
    "Ci": {
      "additionalProperties": false,
      "properties": {
        "branches": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "machine": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": "string"
        },
        "workflows": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repo",
        "branches"
      ],
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "daily"
            ]
          },
          "required": [
            "every"
          ]
        },
        {
          "not": {
            "required": [
              "every"
            ]
          },
          "required": [
            "daily"
          ]
        }
      ],
      "properties": {
        "catch_up": {
          "$ref": "#/$defs/CatchUp",
          "default": "once"
        },
        "command": {
          "type": "string"
        },
        "daily": {
          "type": [
            "string",
            "null"
          ]
        },
        "every": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "Condition": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "schedule": {
              "$ref": "#/$defs/Scheduled"
            }
          },
          "required": [
            "schedule"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/$defs/Command"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "thread": {
              "$ref": "#/$defs/Threads"
            }
          },
          "required": [
            "thread"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "pr": {
              "$ref": "#/$defs/Pr"
            }
          },
          "required": [
            "pr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ci": {
              "$ref": "#/$defs/Ci"
            }
          },
          "required": [
            "ci"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "git": {
              "$ref": "#/$defs/Git"
            }
          },
          "required": [
            "git"
          ],
          "type": "object"
        }
      ]
    },
    "Git": {
      "additionalProperties": false,
      "properties": {
        "branches": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "machine": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "branches"
      ],
      "type": "object"
    },
    "Inbox": {
      "additionalProperties": false,
      "not": {
        "required": [
          "text",
          "text_file"
        ]
      },
      "properties": {
        "notify": {
          "default": false,
          "type": "boolean"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_file": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_per_day": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_running": {
          "description": "do.start 규칙별 동시 한도. 생략·0은 1개(자동화 thread는 일반 실행 한도에서 빠진다).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_commits": {
          "description": "배포 제안: 최근 성공 커밋 또는 등록 head 뒤의 새 main 커밋(1~100).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_gap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "const": 0
            }
          ],
          "description": "생략 또는0이면 제한 없음"
        },
        "usage_session_below": {
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "usage_week_below": {
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MachinePick": {
      "enum": [
        "idlest"
      ],
      "type": "string"
    },
    "Message": {
      "additionalProperties": false,
      "not": {
        "required": [
          "text",
          "text_file"
        ]
      },
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread": {
          "type": "string"
        }
      },
      "required": [
        "thread"
      ],
      "type": "object"
    },
    "Pr": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ProfilePick": {
      "enum": [
        "first",
        "week-left"
      ],
      "type": "string"
    },
    "Reuse": {
      "enum": [
        "new",
        "open"
      ],
      "type": "string"
    },
    "Scheduled": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "daily"
            ]
          },
          "required": [
            "every"
          ]
        },
        {
          "not": {
            "required": [
              "every"
            ]
          },
          "required": [
            "daily"
          ]
        }
      ],
      "properties": {
        "catch_up": {
          "$ref": "#/$defs/CatchUp",
          "default": "once"
        },
        "daily": {
          "type": [
            "string",
            "null"
          ]
        },
        "every": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Start": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "memory": {
                "const": true
              }
            },
            "required": [
              "memory"
            ]
          },
          "then": {
            "properties": {
              "reuse": {
                "const": "open"
              }
            },
            "required": [
              "reuse"
            ]
          }
        },
        {
          "if": {
            "required": [
              "close_idle"
            ]
          },
          "then": {
            "properties": {
              "reuse": {
                "const": "open"
              }
            },
            "required": [
              "reuse"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "text_file"
                ]
              },
              {
                "required": [
                  "brief_file"
                ]
              }
            ]
          },
          "required": [
            "text"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "brief_file"
                ]
              }
            ]
          },
          "required": [
            "text_file"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "text_file"
                ]
              }
            ]
          },
          "required": [
            "brief_file"
          ]
        }
      ],
      "properties": {
        "brief_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "close_idle": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine_pick": {
          "$ref": "#/$defs/MachinePick",
          "default": "idlest"
        },
        "machines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "memory": {
          "default": false,
          "description": "open 전용. 기억을 보존하고 SessionStart(압축·재개 포함)에서 brief와 memory.md 재독을 안내한다.",
          "type": "boolean"
        },
        "profile_pick": {
          "$ref": "#/$defs/ProfilePick",
          "default": "first"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "reports": {
          "default": false,
          "type": "boolean"
        },
        "reuse": {
          "$ref": "#/$defs/Reuse",
          "default": "new",
          "description": "new는 새 thread, open은 같은 규칙의 열린 thread에 이어 보냄(Claude·Codex)."
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "wait": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "wait_max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "const": 0
            }
          ],
          "description": "생략 또는0이면 제한 없음"
        }
      },
      "required": [
        "title",
        "profiles",
        "machines"
      ],
      "type": "object"
    },
    "Threads": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include_automation": {
          "description": "자동화가 띄운 thread의 사건도 받는다(plan t-0475 §3.5). 기본은 뺀다: 자동화 thread의 보고가 규칙을 깨워 다시 thread를 띄우는\n고리를 막는다. 켜도 이 규칙이 띄운 thread의 사건은 늘 뺀다",
          "type": "boolean"
        },
        "repos": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "do": {
      "$ref": "#/$defs/Action"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "limits": {
      "$ref": "#/$defs/Limits",
      "default": {}
    },
    "on": {
      "$ref": "#/$defs/Condition"
    },
    "title": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "on",
    "do"
  ],
  "title": "AAA 자동화",
  "type": "object"
}
