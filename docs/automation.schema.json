{
  "$defs": {
    "AutomationAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notice",
              "type": "string"
            },
            "notify": {
              "default": false,
              "type": "boolean"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "text_file": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "message",
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "text_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "thread": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "thread"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "brief_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "close_idle": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "thread",
              "type": "string"
            },
            "machine_pick": {
              "$ref": "#/$defs/AutomationMachinePick",
              "default": "idlest"
            },
            "machines": {
              "description": "비우거나 생략하면 자동 머신(workspace 허용·독점 예약·착지 중·비중으로 host가 고른다)",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "memory": {
              "default": false,
              "type": "boolean"
            },
            "profile_pick": {
              "$ref": "#/$defs/AutomationProfilePick",
              "default": "first"
            },
            "profiles": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "reports": {
              "default": false,
              "type": "boolean"
            },
            "reuse": {
              "$ref": "#/$defs/AutomationReuse",
              "default": "new"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "text_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "wait": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "wait_max": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "title",
            "profiles"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "kind": {
              "const": "command",
              "type": "string"
            },
            "machine": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "proposal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AutomationCatchUp": {
      "enum": [
        "once",
        "skip"
      ],
      "type": "string"
    },
    "AutomationCondition": {
      "additionalProperties": false,
      "properties": {
        "branches": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include_automation": {
          "type": "boolean"
        },
        "min_commits": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_open_threads": {
          "description": "일정에 필요한 열린 일반 thread 최소 개수. 자동화·완료·보류 thread는 제외한다.",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_changed": {
          "type": "boolean"
        },
        "repos": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workflows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AutomationEventSource": {
      "enum": [
        "thread",
        "ci",
        "git"
      ],
      "type": "string"
    },
    "AutomationMachinePick": {
      "enum": [
        "idlest"
      ],
      "type": "string"
    },
    "AutomationMessage": {
      "not": {
        "required": [
          "text",
          "text_file"
        ]
      }
    },
    "AutomationNotice": {
      "not": {
        "required": [
          "text",
          "text_file"
        ]
      }
    },
    "AutomationObserve": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "kind": {
              "const": "command",
              "type": "string"
            },
            "machine": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "AutomationPolicy": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_per_day": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_running": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_gap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "const": 0
            }
          ]
        },
        "usage_session_below": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "usage_week_below": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AutomationProfilePick": {
      "enum": [
        "first",
        "week-left"
      ],
      "type": "string"
    },
    "AutomationReuse": {
      "enum": [
        "new",
        "open"
      ],
      "type": "string"
    },
    "AutomationThread": {
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "text_file"
                ]
              },
              {
                "required": [
                  "brief_file"
                ]
              }
            ]
          },
          "required": [
            "text"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "brief_file"
                ]
              }
            ]
          },
          "required": [
            "text_file"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "text_file"
                ]
              }
            ]
          },
          "required": [
            "brief_file"
          ]
        }
      ],
      "properties": {
        "wait_max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "const": 0
            }
          ]
        }
      }
    },
    "AutomationTrigger": {
      "oneOf": [
        {
          "additionalProperties": false,
          "oneOf": [
            {
              "not": {
                "required": [
                  "daily"
                ]
              },
              "required": [
                "every"
              ]
            },
            {
              "not": {
                "required": [
                  "every"
                ]
              },
              "required": [
                "daily"
              ]
            }
          ],
          "properties": {
            "catch_up": {
              "$ref": "#/$defs/AutomationCatchUp",
              "default": "once"
            },
            "daily": {
              "type": [
                "string",
                "null"
              ]
            },
            "every": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "schedule",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "event",
              "type": "string"
            },
            "machine": {
              "type": [
                "string",
                "null"
              ]
            },
            "repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/AutomationEventSource"
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/AutomationAction"
    },
    "condition": {
      "$ref": "#/$defs/AutomationCondition",
      "default": {}
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "observe": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutomationObserve"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "$ref": "#/$defs/AutomationPolicy",
      "default": {}
    },
    "schema": {
      "const": 2
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/AutomationTrigger"
    }
  },
  "required": [
    "schema",
    "trigger",
    "action"
  ],
  "title": "AAA 자동화 v2",
  "type": "object"
}
