{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallContract",
  "description": "schema/fixture 판정용 묶음. 실제 CLI stdout envelope에는 이 wrapper를 쓰지 않는다.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "invocation"
        },
        "value": {
          "$ref": "#/$defs/InstallInvocation"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "plan"
        },
        "value": {
          "$ref": "#/$defs/InstallPlan"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "result"
        },
        "value": {
          "$ref": "#/$defs/InstallResult"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "stream"
        },
        "value": {
          "$ref": "#/$defs/InstallStreamItem"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "authorization"
        },
        "value": {
          "$ref": "#/$defs/InstallAuthorization"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "grant"
        },
        "value": {
          "$ref": "#/$defs/InstallEnrollmentGrant"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    }
  ],
  "$defs": {
    "InstallAccount": {
      "type": "string",
      "enum": [
        "current-user"
      ]
    },
    "InstallArch": {
      "type": "string",
      "enum": [
        "aarch64",
        "x86_64"
      ]
    },
    "InstallAuthorization": {
      "description": "private 입력. Debug를 구현하지 않으며 public 결과나 TS 출력에 포함하지 않는다.",
      "type": "object",
      "properties": {
        "claims": {
          "$ref": "#/$defs/InstallAuthorizationClaims"
        },
        "enrollment": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstallEnrollmentGrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "claims",
        "signature"
      ]
    },
    "InstallAuthorizationClaims": {
      "description": "서명 전 claims. 이 구조체를 deserialize했다는 사실은 승인이 아니다.",
      "type": "object",
      "properties": {
        "binary_sha256": {
          "type": "string"
        },
        "expires_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "installation_id": {
          "type": "string"
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "issued_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "issuer": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstallPermission"
          }
        },
        "plan_sha256": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/InstallPlatform"
        },
        "schema": {
          "$ref": "#/$defs/InstallAuthorizationSchema"
        },
        "target_account": {
          "type": "string"
        }
