      "additionalProperties": false,
      "required": [
        "schema",
        "installation_id",
        "plan_sha256",
        "platform",
        "target_account",
        "binary_sha256",
        "permissions",
        "issued_at_ms",
        "expires_at_ms",
        "nonce",
        "issuer"
      ]
    },
    "InstallAuthorizationSchema": {
      "type": "string",
      "enum": [
        "aaa.install.authorization.v1"
      ]
    },
    "InstallChange": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
