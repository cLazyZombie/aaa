    "InstallChangeState": {
      "type": "string",
      "enum": [
        "planned",
        "applied",
        "unchanged",
        "pending",
        "reverted",
        "failed"
      ]
    },
    "InstallCheck": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/InstallCheckState"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ]
